                    "rawQuery": true,
                    "rawSql": "with waits as (\r\n  select\r\n    extract(epoch from (r.created_at - mq.created_at)) as wait_ms\r\n  from rooms r\r\n  join match_queue mq\r\n    on mq.user_id in (r.user1_id, r.user2_id)\r\n  where r.created_at >= now() - interval '1 hour'\r\n)\r\nselect\r\n  percentile_cont(0.95) within group (order by wait_ms) as p95_ms,\r\n  percentile_cont(0.99) within group (order by wait_ms) as p99_ms\r\nfrom waits;",
                    "refId": "A",
                    "sql": {
